#!/bin/sh
#
# 上海电信 A 面（EPG）鉴权报文写入工具 —— 手动执行，不挂开机、不做默认值。
#
# 为什么单独做工具而不写进默认配置：
#   125/60 这两个长报文绑着上海电信的鉴权口径，塞进所有人的镜像就是污染。
#   需要的人自己跑一次，落到自己的 /etc/config/dhcp。
#
# 用法：iptv-dhcp-hints <机顶盒MAC> [给它固定的内网IP]
#   例：iptv-dhcp-hints 88:94:7e:4a:79:aa 192.168.3.177
#
# 写入的内容（只对这台盒子的 MAC 生效，用 dnsmasq tag 隔离）：
#   Option 125（force）  EPON 路由器型号标识，A 面认这个
#   Option 60            厂商类标识，同样属于 A 面口径
#   Option 15 / 28       置空 = 抑制。**28 必须抑制**：部分机顶盒会把
#                        应答里的广播地址当成自己的源地址，随后 ARP 全废、
#                        界面报“网络未连接”（0095），而从报文上看一切标准。

[ -n "$1" ] || {
	echo "usage: $0 <box-mac> [fixed-ip]" >&2
	exit 1
}

MAC=$(echo "$1" | tr 'A-Z' 'a-z' | tr -d ' \t')
IP="$2"

HINT125='00:00:00:00:1a:02:06:48:47:57:2d:43:54:03:04:5a:58:48:4e:0a:02:20:00:0b:02:00:55:0d:02:00:2e:3c:1e:00:00:01:00:02:03:43:50:45:03:0e:45:38:20:45:50:4f:4e:20:52:4f:55:54:45:52:04:03:31:2e:30'
HINT60='00:00:01:06:68:75:61:71:69:6e:02:0a:48:47:55:34:32:31:4e:20:76:33:03:0a:48:47:55:34:32:31:4e:20:76:33:04:10:32:30:30:2e:55:59:59:2e:30:2e:41:2e:30:2e:53:48:05:04:00:01:00:50'

TAG="iptv$(echo "$MAC" | tr -d ':' | cut -c7-12)"

has() { uci -q show dhcp | grep -qF "$1"; }

if has "tag:$TAG"; then
	echo "tag $TAG 已存在，跳过 host 段"
else
	IDX=$(uci add dhcp host)
	uci set dhcp.$IDX.mac="$MAC"
	uci set dhcp.$IDX.tag="$TAG"
	uci set dhcp.$IDX.name="IPTV"
	[ -n "$IP" ] && uci set dhcp.$IDX.ip="$IP"
fi

if has "125,$HINT125"; then
	echo "Option 125 已存在，跳过"
else
	uci add_list dhcp.@dnsmasq[0].dhcp_option_force="tag:$TAG,125,$HINT125"
fi

if has "60,$HINT60"; then
	echo "Option 60 已存在，跳过"
else
	uci add_list dhcp.@dnsmasq[0].dhcp_option="tag:$TAG,60,$HINT60"
fi

for o in 15 28; do
	if has "tag:$TAG,$o"; then
		echo "抑制 Option $o 已存在，跳过"
	else
		uci add_list dhcp.@dnsmasq[0].dhcp_option="tag:$TAG,$o"
	fi
done

uci commit dhcp
/etc/init.d/dnsmasq reload >/dev/null 2>&1 || /etc/init.d/dnsmasq restart >/dev/null 2>&1

echo "done: tag=$TAG mac=$MAC ip=${IP:-<dhcp>}"
echo "核对：uci show dhcp | grep $TAG"
echo "提示：机顶盒要真断电冷启才会重新走 A/B 认证"
