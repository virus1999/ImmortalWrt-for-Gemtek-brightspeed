#!/bin/sh
# IPTV 组播 - 终态(2026-11-23 22:18 验证): 三口 multicast_router=1 + dn1 multicast_flood=1
# router=1: 让上游/本桥的 IGMP query 能转到机顶盒, 盒子才会回应, 成员才不 260s 过期
# dn1 flood=1: 兜底, 只在"该组桥里没有任何成员"时才起作用(有成员时桥只按成员转发)
# 上游续订由 /etc/init.d/iptv-keepalive (v2) 负责, 不在这里做
[ "$ACTION" = "ifup" ] || [ "$ACTION" = "ifupdate" ] || exit 0
for p in mux-up1 mux-dn1 mux-mc1; do
  [ -e /sys/class/net/br-mux-1/brif/$p ] || continue
  echo 1 > /sys/class/net/br-mux-1/brif/$p/multicast_router 2>/dev/null
done
echo 1 > /sys/class/net/br-mux-1/brif/mux-dn1/multicast_flood 2>/dev/null
logger -t iptv-mcast "router=1 (3 ports) + dn1 flood=1 applied"
