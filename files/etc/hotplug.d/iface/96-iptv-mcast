#!/bin/sh
# IPTV 组播口属性（条件化版，2026-11-25 单桥修订）
#
# 背景：2026-11-25 实测，上海电信不同频道的直播流分别落在服务 VLAN(85) 与
# 组播 VLAN(51) 上，而机顶盒只在 85 面发 IGMP 报告。旧固件按 VLAN 各建一座桥，
# 成员登记在 br-mux-1、流却从 br-mux-2 进来，桥永远凑不到一起
#   -> 表现就是“出画面约十秒后冻结，换台又能再撑十秒”。
# iptv-apply 已改为“所有划入的 VLAN 并进 br-mux-1”，本脚本据此把该桥里
# 每个 mux-up*/mux-dn* 端口都设成 multicast_router=1：
#   router=1 -> 上游/本桥的 IGMP query 能转到机顶盒，盒子才会应答，成员不再 260s 过期
#   flood=1  -> 只给 mux-dn1 兜底，仅当该组在该桥里没有成员时生效
#
# 出厂化：只有“启用了 IPTV + 单线复用 trunk + 桥存在”才动手，否则 skip 并记日志。

[ "$ACTION" = "ifup" ] || [ "$ACTION" = "ifupdate" ] || exit 0

BR=br-mux-1

[ -d /sys/class/net/$BR/brif ] || {
	logger -t iptv-mcast "skip: $BR not present"
	exit 0
}

[ "$(uci -q get onu-iptv.config.enabled)" = "1" ] || {
	logger -t iptv-mcast "skip: onu-iptv disabled"
	exit 0
}

[ "$(uci -q get onu-iptv.config.mode)" = "trunk" ] || {
	logger -t iptv-mcast "skip: onu-iptv mode is not trunk"
	exit 0
}

changed=0
for d in /sys/class/net/$BR/brif/mux-up* /sys/class/net/$BR/brif/mux-dn*; do
	[ -e "$d/multicast_router" ] || continue
	if [ "$(cat "$d/multicast_router" 2>/dev/null)" != "1" ]; then
		echo 1 > "$d/multicast_router" 2>/dev/null && changed=$((changed + 1))
	fi
done

f=/sys/class/net/$BR/brif/mux-dn1/multicast_flood
if [ -e "$f" ] && [ "$(cat "$f" 2>/dev/null)" != "1" ]; then
	echo 1 > "$f" 2>/dev/null && changed=$((changed + 1))
fi

if [ "$changed" -gt 0 ]; then
	logger -t iptv-mcast "applied: $changed attribute(s) on $BR"
fi

exit 0
