#!/bin/sh
# IPTV 组播口属性（条件化版，2026-11-25）
#
# 终态（与 11-23 验证一致）：三口 multicast_router=1 + mux-dn1 multicast_flood=1
#   router=1 -> 让上游/本桥的 IGMP query 能转到机顶盒，盒子才会应答，成员才不 260s 过期
#   flood=1  -> 兜底，只在“该组桥里没有成员”时起作用
#
# 出厂化改动：只有“启用了 IPTV + 单线复用 trunk + 桥与端口存在”才动手，
# 否则直接 skip 并把原因写进日志；不再无条件打 "applied"（那会让没有 IPTV 的机器
# 看上去像配置生效了）。

[ "$ACTION" = "ifup" ] || [ "$ACTION" = "ifupdate" ] || exit 0

BR=br-mux-1

[ -d /sys/class/net/$BR/brif ] || {
	logger -t iptv-mcast "skip: $BR not present"
	exit 0
}

[ "$(uci -q get onu-iptv.config.enabled)" = "1" ] || {
	logger -t iptv-mcast "skip: onu-iptv disabled"
	exit 0
}

[ "$(uci -q get onu-iptv.config.mode)" = "trunk" ] || {
	logger -t iptv-mcast "skip: onu-iptv mode is not trunk"
	exit 0
}

changed=0
for p in mux-up1 mux-dn1 mux-mc1; do
	f=/sys/class/net/$BR/brif/$p/multicast_router
	[ -e "$f" ] || continue
	if [ "$(cat $f 2>/dev/null)" != "1" ]; then
		echo 1 > $f 2>/dev/null && changed=$((changed + 1))
	fi
done

f=/sys/class/net/$BR/brif/mux-dn1/multicast_flood
if [ -e "$f" ] && [ "$(cat $f 2>/dev/null)" != "1" ]; then
	echo 1 > $f 2>/dev/null && changed=$((changed + 1))
fi

if [ "$changed" -gt 0 ]; then
	logger -t iptv-mcast "applied: $changed attribute(s) on $BR"
fi

exit 0
