#!/bin/sh /etc/rc.common
# IPTV 直播保活服务（procd 守护）
#
# 2026-11-25 出厂化：只在“启用了 IPTV 且为单线复用 trunk”时才拉起循环。
# 以前是无条件 spawn：onu-iptv.enabled=0 的机器上也会常驻一个 while 循环，
# 既白白占 CPU，又会让日志里出现 br-mux-1 不存在的报错。

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/iptv-keepalive-loop

iptv_active() {
	[ "$(uci -q get onu-iptv.config.enabled)" = "1" ] || return 1
	[ "$(uci -q get onu-iptv.config.mode)" = "trunk" ] || return 1
	[ -x "$PROG" ] || return 1
	return 0
}

start_service() {
	if ! iptv_active; then
		logger -t iptv-keepalive "skip: onu-iptv not enabled or mode!=trunk"
		return 0
	fi

	procd_open_instance
	procd_set_param command $PROG
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "onu-iptv"
}
