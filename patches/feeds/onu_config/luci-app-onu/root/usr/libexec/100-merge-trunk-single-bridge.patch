+# 2026-11-25: every handed-over VLAN joins the same bridge br-mux-1.
+#
+# Shanghai Telecom delivers the live streams of different channels on either
+# the service VLAN (85) or the multicast VLAN (51), while the set-top box only
+# sends its IGMP reports on the service VLAN. With one bridge per VLAN the
+# membership lands in br-mux-1 (mux-dn1) and the stream arrives in br-mux-2
+# (mux-up2): the two never meet, nothing is forwarded, and the picture freezes
+# after about ten seconds - exactly the 2026-11-25 field symptom. Bridging all
+# the upstream VLAN devices into br-mux-1 lets a membership reported on mux-dn1
+# receive the stream from any upstream port, which is the topology that ran
+# stable on 2026-11-23/24.
+#
+# Only the first VLAN keeps a downstream (mux-dn1) device: the STB side of the
+# trunk cable only carries the service VLAN. The remaining VLANs are pure extra
+# upstreams on the same bridge.
 write_trunk_network() {
 	local vid idx=0
 
@@ -692,25 +708,29 @@
 		uci set "network.mux_up$idx.vid"="$vid"
